flowchart TD

subgraph Inputs["Inputs and Config"]
    inst["Problem instance<br/>example_50T.json / example_70T.json / future instances"]
    cfgNested["ga_config.json<br/>Nested GA config"]
    cfgStatic["ga_config.static_baseline.json<br/>Standalone baseline config"]
end

subgraph Modules["Main Code Modules"]
    opt["OptimizerGa.py<br/>Outer GA tuner"]
    sched["SchedulerGa.py<br/>Standalone benchmark runner"]
    inner["GAImplementation.py<br/>Inner scheduler GA"]
    cmp["CompareGaRuns.py<br/>Comparison pipeline"]
end

subgraph Nested["Nested GA Experiment"]
    n1["Load instance and nested config"]
    n2["Outer individual = one scheduler hyperparameter set<br/>pop_size, cxpb, mutpb, ngen,<br/>task-order probability,<br/>processor-allocation probability,<br/>message-priority shuffle probability,<br/>message-path-index probability"]
    n3["Inject hyperparameters into inner GA"]
    n4["Run inner scheduler GA for inner_repeats<br/>with different seeds"]
    n5["Compute outer fitness = mean makespan"]
    n6["Evolve outer population across generations"]
    n7["Select top outer candidates"]
    n8["Validate selected candidates on unseen seeds"]
end

subgraph NestedOut["Nested Run Outputs"]
    nh["*_history.json"]
    ne["*_evaluations.jsonl"]
    nb["*_best_result.json"]
    nv["*_validation_results.json"]
    np["Nested plots<br/>objective history, runtime tradeoff,<br/>repeat stability, diversity,<br/>hyperparameter trajectories, validation"]
end

subgraph Static["Standalone GA Benchmark"]
    s1["Load instance and static config"]
    s2["Run fixed scheduler GA for benchmark_repeats<br/>with different seeds"]
    s3["Store per-run generation history"]
    s4["Aggregate benchmark statistics<br/>mean, std, runtime"]
end

subgraph StaticOut["Standalone Outputs"]
    sr["*_runs.jsonl"]
    ss["*_results.json"]
    sg["Main convergence plot<br/>makespan over generations<br/>for each run + mean curve"]
    sp["*_repeat_summary.png<br/>final makespan per run"]
    sl["*.log"]
end

subgraph Compare["Per-Instance Comparison"]
    c1["Match by instance name<br/>50T vs 50T, 70T vs 70T"]
    c2["Choose nested source<br/>training or validation"]
    c3["Compare makespan and runtime distributions"]
    c4["Compute Welch t-test and effect size"]
    c5["Write comparison JSON and plots"]
end

